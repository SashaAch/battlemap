{
  "name": "battlemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
